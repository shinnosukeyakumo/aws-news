# 1Password から .env を生成するためのテンプレート。
#   op inject -i .env.op -o .env
# .env は .gitignore 済み。直接編集しないこと。

# Discord チャンネルの Webhook URL
# チャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック → URL をコピー
DISCORD_WEBHOOK_URL="op://<Vault>/aws-news Discord Webhook/url"

# Bedrock を呼ぶ AWS プロファイル（未設定なら default）
# AWS_PROFILE=default
